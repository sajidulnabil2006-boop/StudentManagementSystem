<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" prefHeight="524.0" prefWidth="769.0" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.student.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <Label text="STUDENT MANAGEMENT SYSTEM" textAlignment="CENTER" textFill="WHITE">
      <font>
         <Font name="System Bold" size="23.0" />
      </font>
   </Label>
   <GridPane prefHeight="155.0" prefWidth="729.0">
     <columnConstraints>
       <ColumnConstraints hgrow="SOMETIMES" maxWidth="356.0" minWidth="10.0" prefWidth="61.0" />
       <ColumnConstraints hgrow="SOMETIMES" maxWidth="686.0" minWidth="10.0" prefWidth="668.0" />
     </columnConstraints>
     <rowConstraints>
         <RowConstraints maxHeight="55.0" minHeight="0.0" prefHeight="24.0" vgrow="SOMETIMES" />
       <RowConstraints maxHeight="70.0" minHeight="10.0" prefHeight="38.0" vgrow="SOMETIMES" />
       <RowConstraints maxHeight="50.0" minHeight="10.0" prefHeight="34.0" vgrow="SOMETIMES" />
       <RowConstraints maxHeight="52.0" minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES" />
         <RowConstraints maxHeight="26.0" minHeight="0.0" prefHeight="0.0" vgrow="SOMETIMES" />
         <RowConstraints maxHeight="45.0" minHeight="0.0" prefHeight="2.0" vgrow="SOMETIMES" />
     </rowConstraints>
      <children>
         <TextField fx:id="Name" alignment="TOP_LEFT" nodeOrientation="LEFT_TO_RIGHT" prefHeight="25.0" prefWidth="357.0" promptText="Student Name" GridPane.columnIndex="1">
            <font>
               <Font name="System Bold" size="12.0" />
            </font></TextField>
         <TextField fx:id="ID" promptText="Student Id" GridPane.columnIndex="1" GridPane.rowIndex="1">
            <font>
               <Font name="System Bold" size="12.0" />
            </font></TextField>
         <TextField fx:id="Department" prefHeight="15.0" prefWidth="607.0" promptText="Department" GridPane.columnIndex="1" GridPane.rowIndex="2">
            <font>
               <Font name="System Bold" size="12.0" />
            </font></TextField>
         <TextField fx:id="CGPA" prefHeight="0.0" prefWidth="703.0" promptText="CGPA" GridPane.columnIndex="1" GridPane.rowIndex="3">
            <font>
               <Font name="System Bold" size="12.0" />
            </font></TextField>
      </children>
   </GridPane>
   <HBox alignment="CENTER" prefHeight="40.0" prefWidth="729.0" spacing="20.0">
      <children>
          <Button onAction="#searchStudent" text="SEARCH" />
         <Button mnemonicParsing="false" onAction="#processData" style="-fx-background-color: #27ae60;" text="ADD" textAlignment="CENTER" textFill="#433535" />
         <Button mnemonicParsing="false" onAction="#updateStudent" style="-fx-background-color: #3498db;" text="UPDATE " textAlignment="CENTER" />
         <Button mnemonicParsing="false" onAction="#deleteStudent" style="-fx-background-color: #e74c3c;" text="DELETE" textAlignment="CENTER" textFill="#140f0f" />
      </children>
   </HBox>

    <Label fx:id="welcomeText" text="STUDENTS HISTRY" textAlignment="CENTER" textFill="WHITE">
      <font>
         <Font name="System Bold" size="24.0" />
      </font></Label>
   <TableView fx:id="studentTable" prefHeight="200.0" prefWidth="200.0">
     <columns>
       <TableColumn fx:id="colName" prefWidth="87.0" text="NAME " />
       <TableColumn fx:id="colID" prefWidth="122.0" text="ID " />
         <TableColumn fx:id="colDept" prefWidth="203.0" text="DEPARTMENT" />
         <TableColumn fx:id="colCGPA" prefWidth="188.0" text="CGPA" />
     </columns>
      <columnResizePolicy>
         <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
      </columnResizePolicy>
   </TableView>
</VBox>
